# HIDL 1.0 touchfeature service provided by the device
allow platform_app hal_touchfeature_xiaomi_hwservice:hwservice_manager find;
binder_call(platform_app, hal_touchfeature_xiaomi_default)
allow priv_app hal_touchfeature_xiaomi_hwservice:hwservice_manager find;
binder_call(priv_app, hal_touchfeature_xiaomi_default)
